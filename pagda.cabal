cabal-version: 3.8
name:          pagda
version:       1.0.0
synopsis:      Agda package manager using Nix
category:      Development
homepage:      https://github.com/WhatisRT/pagda
author:        WhatisRT
license:       MIT
license-file:  LICENSE
build-type:    Simple
extra-source-files:
    README.md
    .gitignore
    default.nix
    flake.nix
    flake.lock
    .github/actions/setup/action.yml
    .github/workflows/*.yml
    nix/**/*.nix
    nix/**/*.sh
    nix/**/*.js
    nix/**/*.patch
    examples/**/*.nix
    examples/**/*.md
    examples/**/*.agda-lib
    examples/**/*.svg
    test/e2e/README.md
    test/e2e/build-missing-nix.golden
    test/e2e/cases/**/*.agda
    test/e2e/cases/**/*.agda-lib
    test/e2e/cases/**/*.agdai
    test/e2e/cases/**/*.conf
    test/e2e/cases/**/*.golden
    test/e2e/cases/**/*.lock
    test/e2e/cases/**/*.nix
    test/e2e/cases/**/*.sh
    test/e2e/cases/**/*.txt
    test/e2e/cases/**/.gitignore
    test/e2e/cases/**/check-env
    test/e2e/cases/**/cmd
    test/e2e/cases/**/cwd
    test/e2e/cases/**/nix
    test/e2e/cases/**/program
    test/e2e/cases/**/stdin
    test/regression/cases/**/*.agda-lib
    test/regression/cases/**/*.nix
    test/regression/cases/**/.agda-lib
    test/regression/cases/**/expect-parse-failure

common warnings
    ghc-options: -Wall

executable pagda
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.18 && <5
                    , optparse-applicative >=0.18
                    , parsec >=3.1
                    , filepath
                    , directory
                    , process
                    , unordered-containers
                    , aeson >=2.2
                    , text

    default-language: GHC2021
    other-modules:    AgdaLib
                    , Templates
                    , Pagda
                    , Update
                    , Paths_pagda
    autogen-modules:  Paths_pagda

executable agda-check
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   agda-check, app
    other-modules:    Pagda
    build-depends:    base >=4.18 && <5
                    , directory
                    , filepath
                    , process
                    , unix
    -- Don't let agda-check's own RTS consume `+RTS ... -RTS`; pass them through
    -- as ordinary arguments so they reach the underlying agda.
    ghc-options:      -rtsopts=ignoreAll
    default-language: GHC2021

test-suite e2e
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Main.hs
    hs-source-dirs:     test/e2e
    other-modules:      InitTests
                      , UpdateTests
    build-depends:      base >=4.18 && <5
                      , bytestring
                      , directory
                      , extra
                      , filepath
                      , process
                      , tasty
                      , tasty-golden
                      , text
                      , aeson
                      , tasty-hunit
    build-tool-depends: pagda:pagda, pagda:agda-check
    default-language:   GHC2021

test-suite regression
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test/regression, app
    other-modules:    AgdaLib
    build-depends:    base >=4.18 && <5
                    , bytestring
                    , parsec >=3.1
                    , filepath
                    , directory
                    , tasty
                    , tasty-golden
                    , tasty-hunit
    default-language: GHC2021
